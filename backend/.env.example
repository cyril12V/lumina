# Serveur
PORT=3001
NODE_ENV=development

# Authentification — OBLIGATOIRE en production : générer une valeur aléatoire longue
JWT_SECRET=change-moi-en-production

# URL du frontend (CORS en production + liens dans les emails)
FRONTEND_URL=http://localhost:3000

# SMTP — optionnel en développement (sans ces variables, les emails ne partent pas)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Base de données ─────────────────────────────────────────────────────────
# En développement : ne rien renseigner. Le fichier SQLite est créé
# automatiquement dans backend/data/lumina.db.

# Chemin du fichier SQLite, si l'on dispose d'un disque persistant
# (Docker, VM, disque payant). Laisser vide sinon.
DATABASE_PATH=

# Hébergement gratuit (système de fichiers éphémère) : la base tient en mémoire
# et est sauvegardée sous forme d'instantané vers un stockage objet.
# URL de l'objet en lecture/écriture, ex. Supabase Storage :
#   https://<projet>.supabase.co/storage/v1/object/<bucket>/lumina.db
DATABASE_REMOTE_URL=
DATABASE_REMOTE_TOKEN=

# Délai avant sauvegarde, en ms. Défaut : 100 en local, 2000 en distant.
DATABASE_SAVE_DEBOUNCE_MS=
